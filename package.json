{
	"name": "readhouse",
	"license": "MIT",
	"private": true,
	"version": "1.0.0",
	"description": "Readhouse: a reading room that reads your books aloud with AllTalk. By Motherhouse.",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && stylelint \"src/**/*.{css,svelte}\"",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run && playwright test",
		"test:e2e": "playwright test",
		"gate": "mise run check"
	},
	"dependencies": {
		"@fontsource-variable/eb-garamond": "^5.3.0",
		"fflate": "^0.8.3",
		"htmlparser2": "^12.0.0",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "^6.0.4",
		"@sveltejs/kit": "^3.3.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"postcss-html": "^2.0.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"stylelint": "^17.16.0",
		"stylelint-declaration-strict-value": "^1.13.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
